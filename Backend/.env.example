# Backend/.env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 로컬은 이 파일을 읽고, 서버는 CD가 같은 이름의 환경변수를 넣는다.

# DB. 데이터베이스 yeogidam은 미리 만든다
DB_URL=jdbc:mysql://localhost:3306/yeogidam?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# JWT 서명 키. openssl rand -base64 48
JWT_SECRET=

# 카카오 REST API 키, 클라이언트 시크릿, 콘솔에 등록한 리다이렉트 URI
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/oauth/kakao/callback

# Google OAuth. 카카오만 쓸 때는 비워도 된다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apple. iOS 앱 Bundle ID, 팀 ID, 키 ID, .p8 개인키 본문. 카카오만 쓸 때는 비워도 된다
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 로컬 실행용 회원(local 프로필 전용). 자기 카카오 회원번호. 로그인 뒤 members.provider_user_id에 남는 숫자다
SEED_KAKAO_USER_ID_BEAN=
SEED_KAKAO_USER_ID_LUCKY=
