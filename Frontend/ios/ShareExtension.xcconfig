#include? "../.env"
// The share extension is a separate target and must link the same Sentry Cocoa SDK.
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) "$(SRCROOT)/Pods/sentry-xcframeworks/9.29.0/Sentry.xcframework/ios-arm64_arm64e"
FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) "$(SRCROOT)/Pods/sentry-xcframeworks/9.29.0/Sentry.xcframework/ios-arm64_x86_64-simulator"
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -force_load "$(SRCROOT)/Pods/sentry-xcframeworks/9.29.0/Sentry.xcframework/ios-arm64_arm64e/Sentry.framework/Sentry"
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -force_load "$(SRCROOT)/Pods/sentry-xcframeworks/9.29.0/Sentry.xcframework/ios-arm64_x86_64-simulator/Sentry.framework/Sentry"
